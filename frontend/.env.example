# Frontend Local Environment
PORT=3000
NODE_ENV=development

# Backend API & WebSocket Endpoint (Local Dev Backend Port: 8888)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8888
NEXT_PUBLIC_SOCKET_URL=http://localhost:8888

# Database & Auth Configurations for Server-side Route Handlers
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/nocr?schema=public"
JWT_SECRET=nocr_dev_secret_key
COOKIE_SECURE=false
